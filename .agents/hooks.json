{
  "bootstrap-session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python run_hook.py bootstrap_context.py"
      }
    ]
  },
  "enforce-orchestrator-role": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python .agents/hooks/enforce_orchestrator.py"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|apply_patch|invoke_subagent|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python run_hook.py gate_tool_execution.py"
          }
        ]
      }
    ]
  }
}